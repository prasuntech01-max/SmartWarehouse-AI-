# ==============================================================================
# SmartWarehouse AI - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your deployment.
# NEVER commit sensitive production credentials or actual .env files to Git.
# ==============================================================================

# Database Persistence
SMARTWAREHOUSE_DB_PATH=data/smartwarehouse.db

# Application Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Logging & Diagnostic
LOG_LEVEL=INFO

# Optional Industrial IoT / MQTT Gateway Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60
MQTT_TOPIC_TELEMETRY=warehouse/iot/telemetry
MQTT_TOPIC_ALERTS=warehouse/iot/alerts
